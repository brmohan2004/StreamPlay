# StreamPlay Authorized Video Playback Backend Configuration
PORT=4100
HOST=127.0.0.1

# HMAC secret for signing playback session tokens (set a strong random value in production)
PLAYBACK_SIGNING_SECRET=replace-with-strong-32-byte-random-secret

# Session & cache lifetimes
SESSION_TTL_SECONDS=1800
SOURCE_CACHE_TTL_SECONDS=300
PROVIDER_TIMEOUT_MS=8000

# Set to true to perform upstream HTTP HEAD reachability checks on resolved streams
VALIDATE_UPSTREAM_HEAD=false

# Independently configurable dynamic authorized video providers (zero hardcoded videos)
ENABLE_ARCHIVE_ORG=true
ENABLE_WIKIMEDIA_COMMONS=true
ENABLE_PARTNER_PROVIDER=false

# Optional licensed partner / self-hosted media server (used when ENABLE_PARTNER_PROVIDER=true)
# PARTNER_PROVIDER_NAME=Partner Licensed CDN
# PARTNER_PROVIDER_BASE_URL=https://partner-api.example.com
# PARTNER_PROVIDER_API_KEY=your-server-side-api-key
